{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "eCommerce-dev": {
      "error": "This resource does not support generation in the manifest."
    },
    "postgres": {
      "type": "container.v1",
      "connectionString": "Host={postgres.bindings.tcp.host};Port={postgres.bindings.tcp.port};Username=postgres;Password={postgres-password.value}",
      "image": "docker.io/library/postgres:17.6",
      "volumes": [
        {
          "name": "ecommerce_postgres_data",
          "target": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "eCommerce": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=eCommerce"
    },
    "catalog": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=catalog"
    },
    "orders": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=orders"
    },
    "cache": {
      "type": "container.v1",
      "connectionString": "{cache.bindings.tcp.host}:{cache.bindings.tcp.port},password={cache-password.value}",
      "image": "docker.io/library/redis:8.2",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "redis-server --requirepass $REDIS_PASSWORD --save 60 1"
      ],
      "volumes": [
        {
          "name": "orderflow-redis-data",
          "target": "/data",
          "readOnly": false
        }
      ],
      "env": {
        "REDIS_PASSWORD": "{cache-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 6379
        }
      }
    },
    "messaging": {
      "type": "container.v1",
      "connectionString": "amqp://guest:{messaging-password.value}@{messaging.bindings.tcp.host}:{messaging.bindings.tcp.port}",
      "image": "docker.io/library/rabbitmq:4.1-management",
      "volumes": [
        {
          "name": "orderflow-rabbitmq-data",
          "target": "/var/lib/rabbitmq",
          "readOnly": false
        }
      ],
      "env": {
        "RABBITMQ_DEFAULT_USER": "guest",
        "RABBITMQ_DEFAULT_PASS": "{messaging-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5672
        },
        "management": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 15672
        }
      }
    },
    "maildev": {
      "type": "container.v1",
      "image": "maildev/maildev:latest",
      "bindings": {
        "web": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 1080
        },
        "smtp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 1025
        }
      }
    },
    "identity": {
      "type": "project.v1",
      "path": "../Identity/Identity.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{identity.bindings.http.targetPort}",
        "ConnectionStrings__eCommerce": "{eCommerce.connectionString}",
        "ECOMMERCE_HOST": "{postgres.bindings.tcp.host}",
        "ECOMMERCE_PORT": "{postgres.bindings.tcp.port}",
        "ECOMMERCE_USERNAME": "postgres",
        "ECOMMERCE_PASSWORD": "{postgres-password.value}",
        "ECOMMERCE_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/eCommerce",
        "ECOMMERCE_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/eCommerce",
        "ECOMMERCE_DATABASE": "eCommerce",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "identity"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "catalog-service": {
      "type": "project.v1",
      "path": "../Catalog/Catalog.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{catalog-service.bindings.http.targetPort}",
        "ConnectionStrings__catalog": "{catalog.connectionString}",
        "CATALOG_HOST": "{postgres.bindings.tcp.host}",
        "CATALOG_PORT": "{postgres.bindings.tcp.port}",
        "CATALOG_USERNAME": "postgres",
        "CATALOG_PASSWORD": "{postgres-password.value}",
        "CATALOG_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/catalog",
        "CATALOG_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/catalog",
        "CATALOG_DATABASE": "catalog",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "catalog-service"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "orders-service": {
      "type": "project.v1",
      "path": "../Orders/Orders.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{orders-service.bindings.http.targetPort}",
        "ConnectionStrings__orders": "{orders.connectionString}",
        "ORDERS_HOST": "{postgres.bindings.tcp.host}",
        "ORDERS_PORT": "{postgres.bindings.tcp.port}",
        "ORDERS_USERNAME": "postgres",
        "ORDERS_PASSWORD": "{postgres-password.value}",
        "ORDERS_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/orders",
        "ORDERS_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/orders",
        "ORDERS_DATABASE": "orders",
        "CATALOG-SERVICE_HTTP": "{catalog-service.bindings.http.url}",
        "services__catalog-service__http__0": "{catalog-service.bindings.http.url}",
        "CATALOG-SERVICE_HTTPS": "{catalog-service.bindings.https.url}",
        "services__catalog-service__https__0": "{catalog-service.bindings.https.url}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "orders-service"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "notifications": {
      "type": "project.v1",
      "path": "../Notifications/Notifications.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "Email__SmtpHost": "{maildev.bindings.smtp.host}",
        "Email__SmtpPort": "{maildev.bindings.smtp.port}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "notifications"
      }
    },
    "apigateway": {
      "type": "project.v1",
      "path": "../ApiGateway/ApiGateway.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{apigateway.bindings.http.targetPort}",
        "ConnectionStrings__cache": "{cache.connectionString}",
        "CACHE_HOST": "{cache.bindings.tcp.host}",
        "CACHE_PORT": "{cache.bindings.tcp.port}",
        "CACHE_PASSWORD": "{cache-password.value}",
        "CACHE_URI": "redis://:{cache-password-uri-encoded.value}@{cache.bindings.tcp.host}:{cache.bindings.tcp.port}",
        "IDENTITY_HTTP": "{identity.bindings.http.url}",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "IDENTITY_HTTPS": "{identity.bindings.https.url}",
        "services__identity__https__0": "{identity.bindings.https.url}",
        "CATALOG-SERVICE_HTTP": "{catalog-service.bindings.http.url}",
        "services__catalog-service__http__0": "{catalog-service.bindings.http.url}",
        "CATALOG-SERVICE_HTTPS": "{catalog-service.bindings.https.url}",
        "services__catalog-service__https__0": "{catalog-service.bindings.https.url}",
        "ORDERS-SERVICE_HTTP": "{orders-service.bindings.http.url}",
        "services__orders-service__http__0": "{orders-service.bindings.http.url}",
        "ORDERS-SERVICE_HTTPS": "{orders-service.bindings.https.url}",
        "services__orders-service__https__0": "{orders-service.bindings.https.url}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "apigateway"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "frontend": {
      "type": "container.v1",
      "build": {
        "context": "../Frontend/proyecto",
        "dockerfile": "../Frontend/proyecto/Dockerfile"
      },
      "env": {
        "NODE_ENV": "development",
        "APIGATEWAY_HTTP": "{apigateway.bindings.http.url}",
        "services__apigateway__http__0": "{apigateway.bindings.http.url}",
        "APIGATEWAY_HTTPS": "{apigateway.bindings.https.url}",
        "services__apigateway__https__0": "{apigateway.bindings.https.url}",
        "DEV": "{frontend.bindings.http.targetPort}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "frontend"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 3000
        }
      }
    },
    "worker": {
      "type": "project.v1",
      "path": "../Worker/Worker.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "{eCommerce-dev-dashboard.bindings.otlp-grpc.url}",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
        "OTEL_SERVICE_NAME": "worker"
      }
    },
    "postgres-password": {
      "type": "parameter.v0",
      "value": "{postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    },
    "postgres-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{postgres-password.value}",
      "filter": "uri"
    },
    "cache-password": {
      "type": "parameter.v0",
      "value": "{cache-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "cache-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{cache-password.value}",
      "filter": "uri"
    },
    "messaging-password": {
      "type": "parameter.v0",
      "value": "{messaging-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "eCommerce-dev-dashboard": {
      "type": "container.v1",
      "image": "mcr.microsoft.com/dotnet/nightly/aspire-dashboard:latest",
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 18888
        },
        "otlp-grpc": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 18889
        }
      }
    }
  }
}